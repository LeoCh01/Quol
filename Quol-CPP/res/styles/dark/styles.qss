#title-bar {
    background-color: #222;
    padding: 0;
}

#title-bar * {
    border: none;
    color: white;
    font-weight: bold;
}

#content {
    background-color: #444;
}

#content * {
    color: white;
}

#content QPushButton {
    background-color: #333;
    border-radius: 4px;
    border: 1px solid #444;
    padding: 2px;
}

#content QLineEdit, #content QPlainTextEdit, #content QTextEdit {
    background-color: #3d3d3d;
}

#content QPushButton:hover {
    background-color: #555;
}

#content QComboBox {
    background-color: #333;
}

#content QGroupBox {
    background-color: #444;
}

#content QAbstractItemView {
    background-color: #333;
}

#content QScrollArea QFrame {
    padding: 2px;
    background-color: #333;
}

/* HORIZONTAL/VERTICAL SCROLLBARS */
QScrollBar {
    background: #444;
    margin: 0px;
}

QScrollBar::handle {
    background: #666;
    border-radius: 3px;
    margin: 3px;
}

QScrollBar:hover {
    background: #555;
}

QScrollBar::handle:hover {
    background: #777;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle:horizontal {
    min-width: 20px;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar::handle:vertical {
    min-height: 20px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

QAbstractScrollArea::corner {
    background: #444;
}

QTextBrowser {
    background: #333;
    border: none;
}

/* ── Close button in TitleBar ───────────────────────────────────── */
#close-btn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    color: white;
    font-weight: bold;
}

#close-btn:hover {
    background-color: #c0392b;
}

#close-btn:pressed {
    background-color: #922b21;
}

/* ── Status labels in plugin manager ────────────────────────────── */
#status-active {
    color: #2ecc71;
    font-size: 11px;
}

#status-inactive {
    color: #888;
    font-size: 11px;
}

/* ── Tabs ─────────────────────────────────────────────────────────── */
#content QTabWidget::pane {
    border: 1px solid #555;
    background: #444;
    top: -1px;
}

#content QTabBar::tab {
    background: #333;
    color: white;
    padding: 6px 12px;
    border: 1px solid #555;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

#content QTabBar::tab:selected {
    background: #444;
    border-color: #666;
}

#content QTabBar::tab:hover {
    background: #444;
    border-color: #777;
}

#content QTabBar {
    background-color: #444;
}

/* ── List widget ──────────────────────────────────────────────────── */
#content QListWidget {
    background-color: #333;
    border: 1px solid #555;
}

#content QListWidget::item {
    padding: 2px;
}

#content QListWidget::item:hover {
    background-color: #3d3d3d;
}

#content QListWidget::item:selected {
    background-color: #555;
}

/* ── CheckBox / Button / Label inside QuolPopupWindow content ────── */

QuolPopupWindow #content QPushButton {
    border: 1px solid #555;
    padding: 3px 10px;
}

/* ── Scroll area in popup editors (keymap, etc.) ─────────────────── */
QuolPopupWindow #content QScrollArea {
    background-color: #333;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 0px;
}

QuolPopupWindow #content QScrollArea > QWidget#qt_scrollarea_viewport {
    background-color: #333;
    border-radius: 6px;
}

QuolPopupWindow #content QScrollArea > QWidget#qt_scrollarea_viewport > QWidget {
    background-color: #333;
    border-radius: 6px;
}

QuolPopupWindow #content QWidget#mapRow {
    background-color: #333;
}

/* ── Generic red button (btn-danger): static red, or red↔green toggle ── */
#content QPushButton#btn-danger {
    background-color: #c62828;
    border-color: #b71c1c;
}

#content QPushButton#btn-danger:hover {
    background-color: #e53935;
}

#content QPushButton#btn-danger:checked {
    background-color: #2e7d32;
    border-color: #1b5e20;
}

#content QPushButton#btn-danger:checked:hover {
    background-color: #388e3c;
}

/* ── Generic green toggle button (btn-toggle): neutral → green when checked ── */
#content QPushButton#btn-toggle:checked {
    background-color: #2e7d32;
    border-color: #1b5e20;
}

#content QPushButton#btn-toggle:checked:hover {
    background-color: #388e3c;
}

QToolTip {
    background-color: #333;
    color: #ddd;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 2px;
}
